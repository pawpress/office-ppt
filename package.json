{
  "name": "dsh-lo-office",
  "version": "0.5.0",
  "description": "Drive the locally installed LibreOffice over UNO from DeepSeek Harness: build editable PPTX/ODP decks and render PPTX to PDF or per-slide PNG, using real Impress instead of a pure-JS writer.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "libreoffice",
    "uno",
    "ppt",
    "pptx",
    "impress",
    "slides",
    "presentation"
  ],
  "license": "MIT",
  "author": "dsh-lo-office contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawpress/office-ppt.git"
  },
  "homepage": "https://github.com/pawpress/office-ppt#readme",
  "bugs": {
    "url": "https://github.com/pawpress/office-ppt/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./commands": "./lib/commands.js",
    "./config": "./lib/config.js",
    "./engine": "./lib/engine.js",
    "./tools": "./lib/tools.js",
    "./worker": "./lib/worker.js"
  },
  "bin": {
    "lo-ppt": "bin/lo-ppt.mjs"
  },
  "files": [
    "lib",
    "python",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/tool-schema.test.mjs",
    "test:config": "node test/config.test.mjs",
    "test:store": "node test/store.test.mjs",
    "test:config-tool": "node test/config-tool.test.mjs",
    "test:commands": "node test/commands.test.mjs",
    "test:autofit": "node test/autofit.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:json": "node test/check-json.mjs",
    "test:all": "npm run test && npm run test:config && npm run test:store && npm run test:config-tool && npm run test:commands && npm run test:json && npm run test:autofit && npm run test:smoke"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
